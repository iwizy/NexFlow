      "root": "fixtures/cli/invalid/multiple-projects",
      "args": [],
      "expected": {
        "exitCode": 1,
        "reportedCommand": "validate",
        "inputMode": "directory-project",
        "discovery": "failed",
        "schema": "not-run",
        "diagnosticCodes": [
          "NF-DISCOVERY-MULTIPLE-PROJECTS"
        ],
        "mutation": "none"
      }
    },
    {
      "id": "reject-duplicate-root-key",
      "description": "Reject a duplicated YAML root key without modifying the copied input.",
      "command": "validate",
      "root": "fixtures/cli/valid/minimal-project",
      "args": [],
      "append": {
        "file": "project.yaml",
        "text": "\nkind: Project\n"
      },
      "expected": {
        "exitCode": 1,
        "reportedCommand": "validate",
        "inputMode": "directory-project",
        "discovery": "failed",
        "schema": "not-run",
        "diagnosticCodes": [
          "NF-DISCOVERY-NO-PROJECT",
          "NF-DISCOVERY-UNSAFE-SOURCE"
        ],
        "mutation": "none"
      }
    }
