  "cases": [
    {
      "id": "validate-project-hints",
      "description": "Validate the assembly selected by explicit Project source hints.",
      "command": "validate",
      "root": "fixtures/cli/valid/minimal-project",
      "args": [
        "--project",
        "project.yaml"
      ],
      "expected": {
        "exitCode": 0,
        "reportedCommand": "validate",
        "inputMode": "project-source-hints",
        "discovery": "passed",
        "schema": "passed",
        "diagnosticCodes": [],
        "documentCount": 3,
        "mutation": "none"
      }
    },
    {
      "id": "inspect-valid-project",
      "description": "Inspect the allowlisted declarations and references of a valid project.",
      "command": "inspect",
      "root": "fixtures/cli/valid/minimal-project",
      "args": [],
      "expected": {
        "exitCode": 0,
        "reportedCommand": "inspect",
        "inputMode": "directory-project",
        "discovery": "passed",
        "schema": "passed",
        "diagnosticCodes": [],
        "documentCount": 3,
        "inspection": {
          "resourceCount": 4,
          "referenceCount": 2
        },
        "mutation": "none"
      }
    },
    {
      "id": "reject-yaml-syntax",
      "description": "Reject malformed YAML before schema validation.",
      "command": "validate",
      "root": "fixtures/cli/invalid/yaml-syntax",
      "args": [],
      "expected": {
        "exitCode": 1,
        "reportedCommand": "validate",
        "inputMode": "directory-project",
        "discovery": "failed",
        "schema": "not-run",
        "diagnosticCodes": [
          "NF-DISCOVERY-NO-PROJECT",
          "NF-DISCOVERY-UNSAFE-SOURCE"
        ],
        "mutation": "none"
      }
    },
    {
      "id": "reject-schema-invalid-project",
      "description": "Reject a discovered Project that omits a required structural field.",
      "command": "validate",
      "root": "fixtures/cli/invalid/schema",
      "args": [],
      "expected": {
        "exitCode": 1,
        "reportedCommand": "validate",
        "inputMode": "directory-project",
        "discovery": "passed",
        "schema": "failed",
        "diagnosticCodes": [
          "NF-SCHEMA"
        ],
        "mutation": "none"
      }
    },
    {
      "id": "reject-unsupported-version",
      "description": "Reject a manifest version outside the prototype support window.",
      "command": "validate",
      "root": "fixtures/cli/invalid/unsupported-version",
      "args": [],
      "expected": {
        "exitCode": 3,
        "reportedCommand": "validate",
        "inputMode": "directory-project",
        "discovery": "failed",
        "schema": "not-run",
        "diagnosticCodes": [
          "NF-DISCOVERY-NO-PROJECT",
          "NF-DISCOVERY-UNSUPPORTED-VERSION"
        ],
        "mutation": "none"
      }
    },
    {
      "id": "reject-unsupported-kind",
      "description": "Reject a manifest kind without a supported local schema.",
      "command": "validate",
      "root": "fixtures/cli/invalid/unsupported-kind",
      "args": [],
      "expected": {
        "exitCode": 3,
        "reportedCommand": "validate",
        "inputMode": "directory-project",
        "discovery": "failed",
        "schema": "not-run",
        "diagnosticCodes": [
          "NF-DISCOVERY-NO-PROJECT",
          "NF-DISCOVERY-UNSUPPORTED-KIND"
        ],
        "mutation": "none"
      }
    },
    {
      "id": "reject-source-outside-root",
      "description": "Reject a Project source hint that escapes the explicit root.",
      "command": "validate",
      "root": "fixtures/cli/invalid/hint-escape",
      "args": [],
      "expected": {
        "exitCode": 1,
        "reportedCommand": "validate",
        "inputMode": "directory-project",
        "discovery": "failed",
        "schema": "not-run",
        "diagnosticCodes": [
          "NF-DISCOVERY-OUTSIDE-ROOT"
        ],
        "mutation": "none"
      }
    },
    {
      "id": "reject-source-kind-mismatch",
      "description": "Reject a Project source hint whose document kind does not match the slot.",
      "command": "validate",
      "root": "fixtures/cli/invalid/hint-kind",
      "args": [],
      "expected": {
        "exitCode": 1,
        "reportedCommand": "validate",
        "inputMode": "directory-project",
        "discovery": "failed",
        "schema": "not-run",
        "diagnosticCodes": [
          "NF-DISCOVERY-KIND-MISMATCH"
        ],
        "mutation": "none"
      }
    },
    {
      "id": "reject-runtime-command",
      "description": "Reject a runtime-like command before reading or mutating project content.",
      "command": "run",
      "root": "fixtures/cli/valid/minimal-project",
      "args": [],
      "expected": {
        "exitCode": 2,
        "reportedCommand": null,
        "inputMode": null,
        "discovery": "not-run",
        "schema": "not-run",
        "diagnosticCodes": [
          "NEXFLOW-PROTOTYPE-USAGE"
        ],
        "mutation": "none"
      }
    },
    {
      "id": "reject-ambiguous-project-entry",
