{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nexflow.dev/evaluation/requalification/validation-diagnostics/report.schema.json",
  "title": "Scoped observations, not architecture acceptance",
  "type": "object",
  "additionalProperties": false,
  "required": ["formatVersion", "task", "candidate", "mappingId", "recordedAt", "pins", "harnessRevision", "sourceInventory", "artifacts", "toolchain", "environment", "library", "cli", "limitations", "architectureOutcome"],
  "properties": {
    "formatVersion": {"const": 1},
    "task": {"const": "NF-102-01"},
    "candidate": {"enum": ["typescript", "python", "rust", "go"]},
    "mappingId": {"const": "nf-102-01-observation-v1"},
    "recordedAt": {"type": "string", "pattern": "^\\d{4}-\\d\\d-\\d\\dT.*Z$"},
    "pins": {
      "type": "object", "additionalProperties": false,
      "required": ["sourceRevision", "repairRevision", "specificationRevision", "corpusSha256", "catalogSha256"],
      "properties": {
        "sourceRevision": {"$ref": "#/$defs/revision"}, "repairRevision": {"$ref": "#/$defs/revision"}, "specificationRevision": {"$ref": "#/$defs/revision"},
        "corpusSha256": {"$ref": "#/$defs/hash"}, "catalogSha256": {"$ref": "#/$defs/hash"}
      }
    },
    "harnessRevision": {"$ref": "#/$defs/revision"},
    "sourceInventory": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["path", "sha256"], "properties": {"path": {"type": "string", "pattern": "^(evaluation/prototypes|schemas)/"}, "sha256": {"$ref": "#/$defs/hash"}}}},
    "artifacts": {"type": "array", "minItems": 2, "items": {"type": "object", "additionalProperties": false, "required": ["role", "sha256"], "properties": {"role": {"enum": ["library-entry", "cli-entry", "interpreter"]}, "sha256": {"$ref": "#/$defs/hash"}}}},
    "toolchain": {"type": "object", "minProperties": 1},
    "environment": {"type": "object", "required": ["platform", "architecture", "kernel", "osVersion", "cpuModel", "cpuCount", "cohort"]},
    "library": {"type": "object", "additionalProperties": false, "required": ["outerRuns", "evaluationsPerCase", "innerRepeatAndInputAssertion", "rawResultSha256", "passed", "failed", "results"], "properties": {
      "outerRuns": {"const": 2}, "evaluationsPerCase": {"const": 4}, "innerRepeatAndInputAssertion": {"type": "string"},
      "rawResultSha256": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"$ref": "#/$defs/hash"}},
      "passed": {"type": "integer", "minimum": 0}, "failed": {"type": "integer", "minimum": 0},
      "results": {"type": "array", "minItems": 352, "maxItems": 352, "items": {"type": "object", "additionalProperties": false, "required": ["id", "operation", "actual", "observations", "repeatable", "inputUnchanged", "secondResultSha256", "errors"], "properties": {
        "id": {"type": "string"}, "operation": {"enum": ["semantic-fragment", "workflow-namespace", "artifact-namespace", "manifest-schema", "local-schema", "yaml-parse", "discovery"]},
        "actual": {"type": "object"}, "observations": {"type": "array", "items": {"type": "object"}},
        "repeatable": {"type": "boolean"}, "inputUnchanged": {"type": "boolean"}, "secondResultSha256": {"$ref": "#/$defs/hash"}, "errors": {"type": "array", "items": {"type": "string"}}
      }}}
    }},
    "cli": {"type": "object", "additionalProperties": false, "required": ["runsPerCase", "passed", "failed", "results"], "properties": {
      "runsPerCase": {"const": 2}, "passed": {"type": "integer", "minimum": 0}, "failed": {"type": "integer", "minimum": 0},
      "results": {"type": "array", "minItems": 59, "maxItems": 59, "items": {"type": "object", "additionalProperties": false, "required": ["id", "origin", "args", "expected", "scopeObservation", "inputSha256", "bridgeObservation", "actual", "stdoutSha256", "stderrSha256", "repeatable", "inputUnchanged", "errors"], "properties": {
        "id": {"type": "string"}, "origin": {"type": "string"}, "args": {"type": "array", "items": {"type": "string"}}, "expected": {"type": ["object", "null"]}, "scopeObservation": {"type": ["string", "null"]},
        "inputSha256": {"$ref": "#/$defs/hash"}, "bridgeObservation": {"type": ["object", "null"]}, "actual": {"type": "object"},
        "stdoutSha256": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"$ref": "#/$defs/hash"}}, "stderrSha256": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"$ref": "#/$defs/hash"}},
        "repeatable": {"type": "boolean"}, "inputUnchanged": {"type": "boolean"}, "errors": {"type": "array", "items": {"type": "string"}}
      }}}
    }},
    "limitations": {"type": "object", "required": ["cliCommands", "fullProjectSemanticConformance", "stablePublicApi", "nativeLibraryDetails", "semanticLibraryToPublicCli"]},
    "architectureOutcome": {"const": "not-ready"}
  },
  "$defs": {"revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"}, "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
}
