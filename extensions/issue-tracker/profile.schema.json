{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nexflow.dev/extensions/issue-tracker/profile.schema.json",
  "title": "NexFlow Issue Tracker Extension Draft Profile",
  "type": "object",
  "additionalProperties": false,
  "required": ["profileVersion", "namespace", "displayName", "status", "provider", "surfaces", "requirements", "failurePolicy"],
  "properties": {
    "profileVersion": {"const": "0.1-draft"},
    "namespace": {"const": "io.nexflow.issue_tracker"},
    "displayName": {
      "type": "string",
      "minLength": 1
    },
    "status": {"const": "draft"},
    "provider": {
      "type": "object",
      "additionalProperties": false,
      "required": ["authority", "binding", "versionPolicy"],
      "properties": {
        "authority": {"const": "external"},
        "binding": {"const": "explicit_provider_instance_and_container"},
        "versionPolicy": {"const": "explicit_compatibility_claim"}
      }
    },
    "surfaces": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "uniqueItems": true,
      "items": {
        "oneOf": [
          {"const": {"id": "container", "class": "context_scope", "providerOwned": true, "nexflowTreatment": "not_nexflow_project"}},
          {"const": {"id": "issue", "class": "work_record", "providerOwned": true, "nexflowTreatment": "external_record_not_taskset"}},
          {"const": {"id": "status", "class": "state_signal", "providerOwned": true, "nexflowTreatment": "not_local_completion"}},
          {"const": {"id": "assignee", "class": "identity", "providerOwned": true, "nexflowTreatment": "not_actor_or_authority"}},
          {"const": {"id": "comment", "class": "discussion", "providerOwned": true, "nexflowTreatment": "untrusted_content_not_approval"}},
          {"const": {"id": "attachment", "class": "external_output", "providerOwned": true, "nexflowTreatment": "explicit_import_with_provenance"}},
          {"const": {"id": "webhook", "class": "external_event", "providerOwned": true, "nexflowTreatment": "untrusted_event_input"}}
        ]
      }
    },
    "requirements": {
      "type": "object",
      "additionalProperties": false,
      "required": ["extension", "contextSource", "references", "content", "operations", "authorization", "synchronization", "network", "credentials", "audit"],
      "properties": {
        "extension": {
          "type": "object",
          "additionalProperties": false,
          "required": ["lifecycle", "appliesTo", "requiredCapabilities"],
          "properties": {
            "lifecycle": {
              "type": "array",
              "minItems": 1,
              "maxItems": 1,
              "uniqueItems": true,
              "items": {
                "enum": ["experimental"]
              }
            },
            "appliesTo": {
              "type": "array",
              "minItems": 6,
              "maxItems": 6,
              "uniqueItems": true,
              "items": {
                "enum": ["context", "tasks", "workflow", "permissions", "capabilities", "events"]
              }
            },
            "requiredCapabilities": {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "uniqueItems": true,
              "items": {
                "enum": ["read_context", "access_network"]
              }
            }
          }
        },
        "contextSource": {
          "type": "object",
          "additionalProperties": false,
          "required": ["allowedTypes", "requiredFields", "allowedContentTypes"],
          "properties": {
            "allowedTypes": {
              "type": "array",
              "minItems": 5,
              "maxItems": 5,
              "uniqueItems": true,
              "items": {
                "enum": ["github", "gitlab", "jira", "linear", "custom"]
              }
            },
            "requiredFields": {
              "type": "array",
              "minItems": 4,
              "maxItems": 4,
              "uniqueItems": true,
              "items": {
                "enum": ["uri", "contentTypes", "access", "classification"]
              }
            },
            "allowedContentTypes": {
              "type": "array",
              "minItems": 3,
              "maxItems": 3,
              "uniqueItems": true,
              "items": {
                "enum": ["issues", "tickets", "metadata"]
              }
            }
          }
        },
        "references": {
          "type": "object",
          "additionalProperties": false,
          "required": ["identifiers", "displayKeys", "coreTypedReferences", "taskCorrelation", "actorBinding"],
          "properties": {
            "identifiers": {"const": "provider_instance_container_scoped_opaque"},
            "displayKeys": {"const": "mutable_not_identity"},
            "coreTypedReferences": {"const": "not_defined"},
            "taskCorrelation": {"const": "explicit_local_mapping_only"},
            "actorBinding": {"const": "explicit_local_binding_only"}
          }
        },
        "content": {
          "type": "object",
          "additionalProperties": false,
          "required": ["trust", "instructions", "classification", "linkedContent"],
          "properties": {
            "trust": {"const": "untrusted_external_input"},
            "instructions": {"const": "never_authority"},
            "classification": {"const": "preserve_or_raise"},
            "linkedContent": {"const": "separate_authorization_required"}
          }
        },
        "operations": {
          "type": "array",
          "minItems": 5,
          "maxItems": 5,
          "uniqueItems": true,
          "items": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["id", "effect", "requiredCapabilities", "approvalPolicy"],
                "properties": {
                  "id": {"const": "read_issue"},
                  "effect": {"const": "read"},
                  "requiredCapabilities": {
                    "type": "array",
                    "minItems": 2,
                    "maxItems": 2,
                    "uniqueItems": true,
                    "items": {
                      "enum": ["read_context", "access_network"]
                    }
                  },
                  "approvalPolicy": {"const": "local_policy"}
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["id", "effect", "requiredCapabilities", "approvalPolicy"],
                "properties": {
                  "id": {"const": "create_issue"},
                  "effect": {"const": "write"},
                  "requiredCapabilities": {
                    "type": "array",
                    "minItems": 3,
                    "maxItems": 3,
                    "uniqueItems": true,
                    "items": {
                      "enum": ["manage_tasks", "access_network", "use_credential"]
                    }
                  },
                  "approvalPolicy": {"const": "required_initial_draft"}
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["id", "effect", "requiredCapabilities", "approvalPolicy"],
                "properties": {
                  "id": {"const": "update_issue"},
                  "effect": {"const": "write"},
                  "requiredCapabilities": {
                    "type": "array",
                    "minItems": 3,
                    "maxItems": 3,
                    "uniqueItems": true,
                    "items": {
                      "enum": ["manage_tasks", "access_network", "use_credential"]
                    }
                  },
                  "approvalPolicy": {"const": "required_initial_draft"}
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["id", "effect", "requiredCapabilities", "approvalPolicy"],
                "properties": {
                  "id": {"const": "add_comment"},
                  "effect": {"const": "write"},
                  "requiredCapabilities": {
                    "type": "array",
                    "minItems": 3,
                    "maxItems": 3,
                    "uniqueItems": true,
                    "items": {
                      "enum": ["manage_tasks", "access_network", "use_credential"]
                    }
                  },
                  "approvalPolicy": {"const": "required_initial_draft"}
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["id", "effect", "requiredCapabilities", "approvalPolicy"],
                "properties": {
                  "id": {"const": "transition_issue"},
                  "effect": {"const": "write"},
                  "requiredCapabilities": {
                    "type": "array",
                    "minItems": 3,
                    "maxItems": 3,
                    "uniqueItems": true,
                    "items": {
                      "enum": ["manage_tasks", "access_network", "use_credential"]
                    }
                  },
                  "approvalPolicy": {"const": "required_initial_draft"}
                }
              }
            ]
          },
          "allOf": [
            {
              "contains": {
                "type": "object",
                "required": ["id"],
                "properties": {
                  "id": {"const": "read_issue"}
                }
              },
              "minContains": 1,
              "maxContains": 1
            },
            {
              "contains": {
                "type": "object",
                "required": ["id"],
                "properties": {
                  "id": {"const": "create_issue"}
                }
              },
              "minContains": 1,
              "maxContains": 1
            },
            {
              "contains": {
                "type": "object",
                "required": ["id"],
                "properties": {
                  "id": {"const": "update_issue"}
                }
              },
              "minContains": 1,
              "maxContains": 1
            },
            {
              "contains": {
                "type": "object",
                "required": ["id"],
                "properties": {
                  "id": {"const": "add_comment"}
                }
              },
              "minContains": 1,
              "maxContains": 1
            },
            {
              "contains": {
                "type": "object",
                "required": ["id"],
                "properties": {
                  "id": {"const": "transition_issue"}
                }
              },
              "minContains": 1,
              "maxContains": 1
            }
          ]
        },
        "authorization": {
          "type": "object",
          "additionalProperties": false,
          "required": ["permissionRequired", "operationScope", "providerAccess", "remoteState"],
          "properties": {
            "permissionRequired": {"const": true},
            "operationScope": {"const": "exact_target_fields_and_effect"},
            "providerAccess": {"const": "additional_binding_capability_when_declared"},
            "remoteState": {"const": "never_local_approval_or_acceptance"}
          }
        },
        "synchronization": {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode", "stateMapping", "freshness", "conflicts", "retries", "echoHandling"],
          "properties": {
            "mode": {"const": "explicit_one_operation_no_background_sync"},
            "stateMapping": {"const": "explicit_provider_transition_only"},
            "freshness": {"const": "recheck_expected_revision_before_write"},
            "conflicts": {"const": "stop_and_require_new_decision"},
            "retries": {"const": "no_blind_retry_after_unknown_outcome"},
            "echoHandling": {"const": "correlate_deduplicate_do_not_reauthorize"}
          }
        },
        "network": {
          "type": "object",
          "additionalProperties": false,
          "required": ["outboundPolicy", "outboundCapability", "inboundWebhooks"],
          "properties": {
            "outboundPolicy": {"const": "required_for_provider_calls"},
            "outboundCapability": {"const": "access_network"},
            "inboundWebhooks": {"const": "unsupported_initial_draft"}
          }
        },
        "credentials": {
          "type": "object",
          "additionalProperties": false,
          "required": ["handling", "capability", "authenticatedReads", "scope", "manifestSecrets"],
          "properties": {
            "handling": {"const": "mediated_external_binding"},
            "capability": {"const": "use_credential"},
            "authenticatedReads": {"const": "same_credential_boundary_as_writes"},
            "scope": {"const": "operation_scoped_least_privilege"},
            "manifestSecrets": {"const": "forbidden"}
          }
        },
        "audit": {
          "type": "object",
          "additionalProperties": false,
          "required": ["requiredFor"],
          "properties": {
            "requiredFor": {
              "type": "array",
              "minItems": 9,
              "maxItems": 9,
              "uniqueItems": true,
              "items": {
                "enum": ["context_read", "mutation_decision", "approval_decision", "correlation_decision", "conflict_decision", "retry_decision", "credential_decision", "network_decision", "event_decision"]
              }
            }
          }
        }
      }
    },
    "failurePolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["unknownOperation", "unsupportedProfileOrBinding", "missingDependency", "ambiguousIdentityOrMapping", "staleEvidence", "uncertainWriteOutcome"],
      "properties": {
        "unknownOperation": {"const": "preserve_do_not_execute"},
        "unsupportedProfileOrBinding": {"const": "fail_closed"},
        "missingDependency": {"const": "fail_closed"},
        "ambiguousIdentityOrMapping": {"const": "fail_closed"},
        "staleEvidence": {"const": "reject_when_freshness_required"},
        "uncertainWriteOutcome": {"const": "reconcile_before_new_attempt"}
      }
    }
  }
}
