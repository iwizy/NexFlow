{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nexflow.dev/extensions/mcp/profile.schema.json",
  "title": "NexFlow MCP Extension Draft Profile",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "profileVersion",
    "namespace",
    "displayName",
    "status",
    "protocol",
    "surfaces",
    "requirements",
    "failurePolicy"
  ],
  "properties": {
    "profileVersion": {
      "type": "string",
      "pattern": "^0\\.[0-9]+-draft$"
    },
    "namespace": {
      "const": "io.nexflow.mcp"
    },
    "displayName": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "const": "draft"
    },
    "protocol": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "authority", "versionPolicy"],
      "properties": {
        "name": {
          "const": "Model Context Protocol"
        },
        "authority": {
          "const": "external"
        },
        "versionPolicy": {
          "const": "explicit_compatibility_claim"
        }
      }
    },
    "surfaces": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "class",
          "contextSourceRequired",
          "actionCapabilityRequired"
        ],
        "properties": {
          "id": {
            "type": "string",
            "enum": ["context", "resources", "prompts", "tools", "actions"]
          },
          "class": {
            "type": "string",
            "enum": ["context", "action"]
          },
          "contextSourceRequired": {
            "const": true
          },
          "actionCapabilityRequired": {
            "type": "boolean"
          }
        }
      }
    },
    "requirements": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "extension",
        "contextSource",
        "actionSurfaces",
        "network",
        "credentials",
        "audit"
      ],
      "properties": {
        "extension": {
          "type": "object",
          "additionalProperties": false,
          "required": ["lifecycle", "appliesTo", "requiredCapabilities"],
          "properties": {
            "lifecycle": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "enum": ["experimental"]
              }
            },
            "appliesTo": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "enum": ["context", "capabilities", "permissions", "events"]
              }
            },
            "requiredCapabilities": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "const": "access_mcp"
              }
            }
          }
        },
        "contextSource": {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "requiredMcpFields"],
          "properties": {
            "type": {
              "const": "mcp"
            },
            "requiredMcpFields": {
              "type": "array",
              "minItems": 2,
              "uniqueItems": true,
              "items": {
                "enum": ["serverId", "exposes"]
              }
            }
          }
        },
        "actionSurfaces": {
          "type": "object",
          "additionalProperties": false,
          "required": ["allowlistRequired", "permissionRequired", "approvalPolicy"],
          "properties": {
            "allowlistRequired": {
              "const": true
            },
            "permissionRequired": {
              "const": true
            },
            "approvalPolicy": {
              "const": "required_initial_draft"
            }
          }
        },
        "network": {
          "type": "object",
          "additionalProperties": false,
          "required": ["policy", "capability"],
          "properties": {
            "policy": {
              "const": "required_when_transport_is_networked"
            },
            "capability": {
              "const": "access_network"
            }
          }
        },
        "credentials": {
          "type": "object",
          "additionalProperties": false,
          "required": ["handling"],
          "properties": {
            "handling": {
              "const": "external_only"
            }
          }
        },
        "audit": {
          "type": "object",
          "additionalProperties": false,
          "required": ["requiredFor"],
          "properties": {
            "requiredFor": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "enum": [
                  "tool_execution",
                  "action_execution",
                  "approval_decision",
                  "network_decision"
                ]
              }
            }
          }
        }
      }
    },
    "failurePolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["unknownSurface", "unsupportedProfile", "missingDependency"],
      "properties": {
        "unknownSurface": {
          "const": "preserve_do_not_execute"
        },
        "unsupportedProfile": {
          "const": "fail_closed"
        },
        "missingDependency": {
          "const": "fail_closed"
        }
      }
    }
  }
}
