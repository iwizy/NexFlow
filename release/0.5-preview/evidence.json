  "gates": [
    {
      "id": "B1",
      "status": "ready",
      "scope": "pre-publication technical readiness",
      "basis": "Adopted bounded NF-104 first-alpha profile, scoped Accepted RFC-0025, existing roles and independent version domains; wider RFC-0011 remains Draft."
    },
    {
      "id": "B2",
      "status": "ready",
      "scope": "pre-publication technical readiness",
      "basis": "Actual candidate grammar/help/commands/negative/unsupported cases and no init/runtime surface."
    },
    {
      "id": "B3",
      "status": "ready",
      "scope": "pre-publication technical readiness",
      "basis": "18 immutable local schemas/17 kinds, safe preview diagnostics and explicit absence of NF-CLI/full semantic claim."
    },
    {
      "id": "B4",
      "status": "ready",
      "scope": "pre-publication technical readiness",
      "basis": "Exact security graphs and 30 installed checks; three native OS-network controls, residual tool and untested general/native/CPE scope retained."
    },
    {
      "id": "B5",
      "status": "ready",
      "scope": "pre-publication technical readiness",
      "basis": "Actual staging tarballs, closure/legal/provenance and three native lifecycle records; public-channel observations remain a later publication-phase requirement."
    },
    {
      "id": "B6",
      "status": "ready",
      "scope": "pre-publication technical readiness",
      "basis": "68 source checks and nine successful qualification workflows on the selected package revision. Release Readiness Evidence verifies the assembled packet on the review revision."
    },
    {
      "id": "B7",
      "status": "ready",
      "scope": "pre-publication technical readiness",
      "basis": "Synchronized public/embedded installation, quick start, compatibility/rollback and best-effort support/correction guidance."
    },
    {
      "id": "B8",
      "status": "ready",
      "scope": "pre-publication technical readiness",
      "basis": "Separate delegated technical readiness review; architecture/security lenses in adopted single-maintainer mode. Publication permission and public verification remain pending, never implied."
    }
