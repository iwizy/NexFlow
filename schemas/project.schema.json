{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nexflow.dev/schemas/project.schema.json",
  "title": "NexFlow Project Manifest",
  "type": "object",
  "additionalProperties": true,
  "required": ["specVersion", "kind", "metadata", "project"],
  "properties": {
    "specVersion": {
      "$ref": "common.schema.json#/$defs/specVersion"
    },
    "kind": {
      "const": "Project"
    },
    "metadata": {
      "$ref": "common.schema.json#/$defs/metadata"
    },
    "project": {
      "type": "object",
      "additionalProperties": true,
      "required": ["id", "displayName", "description"],
      "properties": {
        "id": {
          "$ref": "common.schema.json#/$defs/id"
        },
        "displayName": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "license": {
          "type": "string"
        },
        "maintainers": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true,
            "required": ["id", "name"],
            "properties": {
              "id": {
                "$ref": "common.schema.json#/$defs/id"
              },
              "name": {
                "type": "string"
              },
              "role": {
                "type": "string"
              },
              "contact": {
                "type": "string"
              }
            }
          }
        },
        "defaultAutonomy": {
          "$ref": "common.schema.json#/$defs/autonomyLevel"
        },
        "policies": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "requireReview": {
              "type": "boolean"
            },
            "secretHandling": {
              "type": "string"
            },
            "credentialHandling": {
              "$ref": "common.schema.json#/$defs/credentialHandlingPolicy"
            },
            "networkAccess": {
              "description": "Structured outbound network policy or a legacy advisory string. Legacy strings do not grant machine-enforceable access.",
              "oneOf": [
                {
                  "type": "string",
                  "minLength": 1
                },
                {
                  "$ref": "common.schema.json#/$defs/networkAccessPolicy"
                }
              ]
            },
            "humanOverride": {
              "$ref": "common.schema.json#/$defs/humanOverridePolicy"
            },
            "destructiveActions": {
              "type": "string"
            },
            "productionActions": {
              "type": "string"
            }
          }
        },
        "approvalGates": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/approvalGate"
          }
        }
      }
    },
    "manifests": {
      "description": "Optional local source-loading hints for adopted manifests. Paths are not resource identity and do not grant behavior. Use workflow for one Workflow document or workflows for multiple documents, but not both.",
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/sourcePath"
      },
      "properties": {
        "workflow": {
          "$ref": "#/$defs/sourcePath",
          "description": "Legacy-compatible source hint for one Workflow document."
        },
        "workflows": {
          "description": "Source hints for multiple Workflow documents. Discovery retains every document and keys it by workflow.id.",
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/sourcePath"
          }
        }
      },
      "allOf": [
        {
          "not": {
            "required": ["workflow", "workflows"]
          }
        }
      ]
    }
  },
  "$defs": {
    "sourcePath": {
      "type": "string",
      "minLength": 1,
      "pattern": ".*\\S.*"
    }
  }
}
