{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nexflow.dev/schemas/providers.schema.json",
  "title": "NexFlow Providers Manifest",
  "$defs": {
    "providerFeature": {
      "title": "Provider Feature",
      "description": "Closed provider or model support signal used for selection. A provider feature is not a NexFlow action capability, permission, or grant.",
      "type": "string",
      "enum": [
        "text_generation",
        "code_reasoning",
        "tool_reasoning",
        "visual_reasoning",
        "policy_reasoning"
      ]
    },
    "providerFeatureList": {
      "title": "Provider Feature List",
      "description": "Unique provider feature support signals from the core vocabulary.",
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/providerFeature"
      }
    }
  },
  "type": "object",
  "additionalProperties": true,
  "required": ["specVersion", "kind", "metadata", "providers"],
  "properties": {
    "specVersion": {
      "$ref": "common.schema.json#/$defs/specVersion"
    },
    "kind": {
      "const": "ProviderSet"
    },
    "metadata": {
      "$ref": "common.schema.json#/$defs/metadata"
    },
    "providers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["id", "type", "description"],
        "properties": {
          "id": {
            "$ref": "common.schema.json#/$defs/id"
          },
          "type": {
            "type": "string",
            "enum": ["abstract", "openai", "anthropic", "google", "openrouter", "ollama", "custom"]
          },
          "description": {
            "type": "string"
          },
          "features": {
            "$ref": "#/$defs/providerFeatureList"
          },
          "capabilities": {
            "allOf": [
              {
                "$ref": "common.schema.json#/$defs/idList"
              }
            ],
            "deprecated": true,
            "description": "Deprecated provider feature vocabulary retained only for 0.1 migration. It does not reference CapabilitySet. New declarations use features."
          },
          "constraints": {
            "type": "object",
            "additionalProperties": true
          },
          "selection": {
            "type": "object",
            "additionalProperties": true,
            "properties": {
              "strategy": {
                "type": "string"
              },
              "explainability": {
                "type": "object",
                "additionalProperties": true,
                "properties": {
                  "recordSelectionReason": {
                    "type": "boolean"
                  },
                  "recordConstraintsApplied": {
                    "type": "boolean"
                  },
                  "recordFallbackReason": {
                    "type": "boolean"
                  }
                }
              }
            }
          }
        },
        "allOf": [
          {
            "not": {
              "required": ["features", "capabilities"]
            }
          }
        ]
      }
    }
  }
}
