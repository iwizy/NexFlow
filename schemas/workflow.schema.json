{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nexflow.dev/schemas/workflow.schema.json",
  "title": "NexFlow Workflow Manifest",
  "type": "object",
  "additionalProperties": true,
  "required": ["specVersion", "kind", "metadata", "workflow"],
  "properties": {
    "specVersion": {
      "$ref": "common.schema.json#/$defs/specVersion"
    },
    "kind": {
      "const": "Workflow"
    },
    "metadata": {
      "$ref": "common.schema.json#/$defs/metadata"
    },
    "workflow": {
      "type": "object",
      "additionalProperties": true,
      "required": ["id", "displayName", "stages"],
      "properties": {
        "id": {
          "$ref": "common.schema.json#/$defs/id",
          "description": "Workflow identity and owner scope for stage and step namespaces."
        },
        "displayName": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "triggers": {
          "$ref": "common.schema.json#/$defs/stringList"
        },
        "stages": {
          "description": "Workflow-scoped stages. Stage IDs must be unique within this workflow.",
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": true,
            "required": ["id", "displayName", "steps"],
            "properties": {
              "id": {
                "$ref": "common.schema.json#/$defs/id",
                "description": "Stage ID unique within the containing workflow."
              },
              "displayName": {
                "type": "string"
              },
              "steps": {
                "description": "Steps whose IDs are unique across every stage in the containing workflow.",
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": true,
                  "required": ["id", "task"],
                  "properties": {
                    "id": {
                      "$ref": "common.schema.json#/$defs/id",
                      "description": "Workflow-scoped step ID, unique across all stages in the containing workflow."
                    },
                    "task": {
                      "$ref": "common.schema.json#/$defs/id"
                    },
                    "dependsOn": {
                      "$ref": "common.schema.json#/$defs/idList",
                      "description": "Exact step IDs resolved in the containing workflow, including steps in other stages."
                    },
                    "approvalGates": {
                      "$ref": "common.schema.json#/$defs/idList"
                    },
                    "emits": {
                      "$ref": "common.schema.json#/$defs/eventTypeList"
                    }
                  }
                }
              }
            }
          }
        },
        "dependencies": {
          "description": "Edges between exact step IDs in this workflow's workflow-wide step namespace.",
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true,
            "required": ["from", "to"],
            "properties": {
              "from": {
                "$ref": "common.schema.json#/$defs/id",
                "description": "Source step ID in the containing workflow."
              },
              "to": {
                "$ref": "common.schema.json#/$defs/id",
                "description": "Target step ID in the containing workflow."
              },
              "type": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  }
}
